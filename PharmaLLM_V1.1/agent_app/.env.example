# 从 agent_app 目录运行；scripts/init_env.py 会创建随机口令和 JWT 密钥。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8082
DATABASE_URL=postgresql+psycopg://pharma:CHANGE_ME@127.0.0.1:5433/pharma_agent
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_ISSUER=pharma-agent
JWT_AUDIENCE=pharma-agent-ui
ACCESS_TOKEN_MINUTES=120
ALLOW_REGISTRATION=true
MODEL_MODE=openai
PHARMA_VLLM_BASE_URL=http://127.0.0.1:8002/v1
PHARMA_VLLM_MODEL_NAME=pharmallm-v1
PHARMA_VLLM_API_KEY=
MODEL_REVISION=unknown
MODEL_TIMEOUT_SECONDS=120
# 可独立切换路由器；默认复用 PharmaLLM。
ROUTER_MODEL_ALIAS=pharma_llm_sft
ROUTER_BASE_URL=http://127.0.0.1:8002/v1
ROUTER_MODEL_NAME=pharmallm-v1
ROUTER_API_KEY=
MODEL_CONFIG=configs/models.yaml
TOOL_CONFIG=configs/tools.yaml
GRAPH_CONFIG=configs/graph.yaml
MAX_ACTIVE_RUNS=8
MAX_PENDING_RUNS_PER_USER=4
RUN_TIMEOUT_SECONDS=240
RUN_LEASE_SECONDS=60
HISTORY_MESSAGE_LIMIT=20
PROMPT_BYTE_BUDGET=12000
ANSWER_MAX_TOKENS=768
ENABLE_QUEUE=true
REDIS_URL=redis://127.0.0.1:6380/0
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_FAIL_CLOSED=true
STORAGE_ROOT=var/assets
MAX_UPLOAD_BYTES=67108864
# hash 仅用于 CPU 演示；真实语义检索请配置兼容 /embeddings 的服务后重新导入资料。
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256
EMBEDDING_REVISION=demo-v1
ENABLE_FAULTS=false
OTEL_SERVICE_NAME=pharma-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# vLLM 使用独立 Python 环境。默认单卡；八卡配置见 configs/hardware/。
MODEL_PATH=../../PharmaLLM_V1.0/outputs/qwen3-8b-base-pharma-sft
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=32
GPU_MAX_USED_MIB=2048
VLLM_PORT=8002

# CPU medical-image parsing; independent nnU-Net service stays unconfigured by default.
IMAGING_MAX_EXPANDED_BYTES=536870912
IMAGING_MAX_VOXELS=64000000
IMAGING_MAX_SERIES_FILES=1000
ASSET_RETENTION_DAYS=30
SEGMENTATION_BASE_URL=
SEGMENTATION_API_KEY=CHANGE_ME
SEGMENTATION_MODELS_CONFIG=configs/segmentation.yaml
SEGMENTATION_TIMEOUT_SECONDS=1800

# Prepared user checkpoint (service launched separately; never loaded by API/Celery).
NNUNET_MODEL_FOLDER=../model/femoralhead-t1
NNUNET_PYTHON=/path/to/nnunet-env/bin/python
SEGMENTATION_SERVICE_ROOT=var/segmentation-service

# Optional resident segmentation; default endpoint remains disabled until configured.
SEGMENTATION_LOAD_MODE=resident
SEGMENTATION_STARTUP_TIMEOUT_SECONDS=300
